{
  "name": "logos",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "docs:check": "node scripts/check-docs.mjs",
    "test": "NODE_OPTIONS=--conditions=react-server tsx --test \"lib/**/*.test.ts\"",
    "templates:sync": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/sync-templates.ts",
    "r2:prune": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/prune-r2-orphans.ts",
    "sfx:fetch": "node scripts/fetch-default-sfx.mjs",
    "sfx:sync": "tsx --env-file-if-exists=.env.local scripts/fetch-default-sfx.mjs --upload",
    "materials:measure": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/measure-materials.ts",
    "brand:inspect-site": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/inspect-brand-site.ts",
    "event-cm:seed": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/seed-event-cm.ts",
    "event-cm:draft": "NODE_OPTIONS=--conditions=react-server tsx --env-file=.env.local scripts/draft-event-cm-narration.ts",
    "event-cm:walkthrough": "NODE_OPTIONS=--conditions=react-server tsx --env-file-if-exists=.env.local scripts/walkthrough-event-cm.ts && remotion render remotion/index.ts event-cm var/event-cm/walkthrough.mp4 --props=var/event-cm/walkthrough.props.json",
    "event:studio": "remotion studio remotion/index.ts",
    "themes:compare": "tsx scripts/compare-art-directions.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1086.0",
    "@base-ui/react": "^1.6.0",
    "@google/genai": "^2.12.0",
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.6.1",
    "@remotion/google-fonts": "^4.0.472",
    "@remotion/media": "^4.0.472",
    "@remotion/media-utils": "^4.0.472",
    "@remotion/player": "^4.0.472",
    "@supabase/supabase-js": "^2.110.2",
    "@types/three": "^0.180.0",
    "cheerio": "^1.2.0",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "gsap": "^3.15.0",
    "lottie-web": "^5.13.0",
    "motion": "^12.42.2",
    "next": "16.2.10",
    "openai": "^6.48.0",
    "playwright": "^1.61.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "remotion": "^4.0.472",
    "server-only": "^0.0.1",
    "sharp": "^0.35.3",
    "tailwind-merge": "^3.6.0",
    "three": "^0.180.0",
    "unpdf": "^1.8.1",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@remotion/cli": "^4.0.472",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "tsx": "^4.23.1",
    "typescript": "^5"
  }
}
